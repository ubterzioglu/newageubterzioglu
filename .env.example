# Environment variables for Coolify deployment
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-public-api-key

# Optional: If using Prisma (not recommended for Coolify)
# PRISMA_DATABASE_URL=your-prisma-database-url
# PRISMA_ACCELERATE_URL=your-prisma-accelerate-url
# POSTGRES_URL=your-postgres-url